@@ -78,14 +78,32 @@ static void exitFightScreenCB(void* tCaller);
 
 // [JFV] patch 0006: how long each part of loading a fight takes (debug log only)
 static uint64_t gJfvLoadStart, gJfvLoadLast;
+static unsigned long long gJfvLoadSteps[5];
+static int gJfvLoadStepCount;
 static void jfvLoadStep(const char* tStep) {
 	const uint64_t now = getSystemTicks();
+	if (gJfvLoadStepCount < 5) gJfvLoadSteps[gJfvLoadStepCount++] = (unsigned long long)((now - gJfvLoadLast) / 1000);
 	logFormat("[JFV] load %s: %llu ms (total %llu ms)", tStep, (unsigned long long)((now - gJfvLoadLast) / 1000), (unsigned long long)((now - gJfvLoadStart) / 1000));
 	gJfvLoadLast = now;
 }
 
+// [JFV] patch 0013: one line per fight in ux0:data/JFVT00001/loadtimes.txt, in release builds too
+// (the debug log reopens its file for every line, which is far too slow on a real Vita)
+static void jfvWriteLoadTimes() {
+#ifdef VITA
+	FILE* f = fopen("ux0:data/JFVT00001/loadtimes.txt", "a");
+	if (!f) return;
+	fprintf(f, "%s vs %s: total %llu ms (setup %llu, stage %llu, scripts %llu, sprites %llu, rest %llu)\n",
+		getPlayerDisplayName(getRootPlayer(0)), getPlayerDisplayName(getRootPlayer(1)),
+		(unsigned long long)((getSystemTicks() - gJfvLoadStart) / 1000),
+		gJfvLoadSteps[0], gJfvLoadSteps[1], gJfvLoadSteps[2], gJfvLoadSteps[3], gJfvLoadSteps[4]);
+	fclose(f);
+#endif
+}
+
 static void loadFightScreen() {
 	gJfvLoadStart = gJfvLoadLast = getSystemTicks();
+	gJfvLoadStepCount = 0;
 	setWrapperBetweenScreensCB(exitFightScreenCB, NULL);
 
 	logMemoryState();
@@ -187,6 +205,7 @@ static void loadFightScreen() {
 	setPlayerStatemachineToUpdateAgain(getRootPlayer(0));
 	setPlayerStatemachineToUpdateAgain(getRootPlayer(1));
 	jfvLoadStep("rest");
+	jfvWriteLoadTimes();
 	logg("[Fightscreen] Fight screen loaded");
 
 	
