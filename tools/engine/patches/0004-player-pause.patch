+// [JFV] player pause (patch 0004). An UNPAUSABLE actor: Start during the fighting part of a round
+// freezes everything that is pausable (players, physics, timers, effects) via pauseWrapper() and
+// shows "PAUSED"; Start again resumes. Not in the CPU-only modes, where Start already means "quit".
+static struct {
+	int mIsPaused;
+	int mHasText;
+	int mTextID;
+} gJfvPauseData;
+
+static void loadJfvPause(void* tData) {
+	(void)tData;
+	gJfvPauseData.mIsPaused = 0;
+	gJfvPauseData.mHasText = 0;
+}
+
+static void unloadJfvPause(void* tData) {
+	(void)tData;
+	if (gJfvPauseData.mIsPaused) resumeWrapper();
+	gJfvPauseData.mIsPaused = 0;
+}
+
+static int canJfvPause() {
+	const GameMode mode = getGameMode();
+	if (mode == GAME_MODE_WATCH || mode == GAME_MODE_SUPER_WATCH || mode == GAME_MODE_EXHIBIT || mode == GAME_MODE_OSU) return 0;
+	return gGameLogicData.mRoundStateNumber == ROUND_STATE_FIGHT;
+}
+
+static void setJfvPauseText(int tIsVisible) {
+	if (!gJfvPauseData.mHasText) {
+		if (!tIsVisible) return;
+		gJfvPauseData.mTextID = addMugenTextMugenStyle("PAUSED", Vector3D(160, 110, 90), Vector3DI(1, 0, 0));
+		gJfvPauseData.mHasText = 1;
+	}
+	setMugenTextVisibility(gJfvPauseData.mTextID, tIsVisible);
+}
+
+static void updateJfvPause(void* tData) {
+	(void)tData;
+	if (!(hasPressedStartFlankSingle(0) || hasPressedStartFlankSingle(1))) return;
+	if (!gJfvPauseData.mIsPaused) {
+		if (!canJfvPause() || isWrapperPaused()) return;
+		pauseWrapper();
+		gJfvPauseData.mIsPaused = 1;
+		setJfvPauseText(1);
+	}
+	else {
+		resumeWrapper();
+		gJfvPauseData.mIsPaused = 0;
+		setJfvPauseText(0);
+	}
+}
+
+ActorBlueprint getJfvPauseHandler() {
+	return makeActorBlueprint(loadJfvPause, unloadJfvPause, updateJfvPause);
+}
+
 int getDreamGameTime()
 {
 	return gGameLogicData.mGameTime;
