+// JFV: scale a portrait down (never up past tMaxScale) to fit a box, centred horizontally and either
+// centred or bottom-aligned vertically. Character portraits come in many sizes and axes (a 21x54 icon
+// whose axis sits 52 px below its top, 45x33 icons, 46x61 big portraits), and the stock engine draws
+// them at one global scale with no bound. A mirrored portrait (facing left) is placed so it still
+// fills the same box.
+static void fitPortraitInBox(MugenAnimationHandlerElement* tElement, MugenAnimation* tAnimation, MugenSpriteFile* tSprites, const Vector2D& tTopLeft, const Vector2D& tBox, float tMaxScale, int tIsFacingRight, int tIsBottomAligned, float tZ) {
+	const auto size = getAnimationFirstElementSpriteSize(tAnimation, tSprites);
+	if (size.x <= 0 || size.y <= 0 || tBox.x <= 0 || tBox.y <= 0) return;
+	const auto axis = getAnimationFirstElementSpriteOffset(tAnimation, tSprites);
+	float scale = tBox.x / size.x;
+	if (tBox.y / size.y < scale) scale = tBox.y / size.y;
+	if (tMaxScale > 0 && tMaxScale < scale) scale = tMaxScale;
+	const auto dx = (tBox.x - size.x * scale) / 2;
+	const auto dy = tIsBottomAligned ? (tBox.y - size.y * scale) : (tBox.y - size.y * scale) / 2;
+	const auto x = tIsFacingRight ? tTopLeft.x + dx + axis.x * scale : tTopLeft.x + tBox.x - dx - axis.x * scale;
+	setMugenAnimationDrawScale(tElement, Vector2D(scale, scale));
+	setMugenAnimationPosition(tElement, Vector3D(x, tTopLeft.y + dy + axis.y * scale, tZ));
+}
