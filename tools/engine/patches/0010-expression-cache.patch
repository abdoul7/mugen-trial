 {
 	const uint64_t jfvT0 = getSystemTicks();
 	char* text = getAllocatedMugenDefStringVariableForAssignmentAsElement(tElement);
-	*tOutput = parseDreamMugenAssignmentFromString(text);
+	*tOutput = parseDreamMugenAssignmentFromStringCached(text);
 	freeMemory(text);
 	gJfvAssignmentParseTicks += getSystemTicks() - jfvT0;
 	gJfvAssignmentParseCount++;
