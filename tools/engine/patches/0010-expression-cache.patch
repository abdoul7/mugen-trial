 #include "mugenassignment.h"
 
 #include <stdio.h>
@@ -27,13 +29,39 @@ static struct {
 	int mCommandHandlerID;
 } gMugenAssignmentData;
 
+// [JFV] patch 0010: expression cache. Parsing is ~98% of loading a character's scripts, and scripts
+// repeat whole expressions a lot ("ctrl", "time = 0", the same triggers in many states, and every
+// expression twice in a mirror match). Parsed trees are not changed per player while the game runs
+// (static rewriting is off: mugen.cfg staticassignments = 0; raw-variable resolution depends on the
+// name only), and fight-load trees live on the fight memory stack, freed all at once. The one parse-time
+// dependency is "string" -> command index (parseStringConstantFromString), so the key includes the
+// command file the strings are resolved against. Only used while a fight loads (memory stack set).
+static std::unordered_map<std::string, DreamMugenAssignment*> gJfvAssignmentCache;
+static std::string gJfvAssignmentCacheContext;
+static uint32_t gJfvAssignmentCacheHits, gJfvAssignmentCacheMisses;
+
+void setDreamAssignmentCacheContext(const char* tContext) {
+	gJfvAssignmentCacheContext = tContext ? tContext : "";
+}
+
+static void clearJfvAssignmentCache() {
+	if (gJfvAssignmentCacheHits || gJfvAssignmentCacheMisses) {
+		logFormat("[JFV] expression cache: %u reused, %u parsed", gJfvAssignmentCacheHits, gJfvAssignmentCacheMisses);
+	}
+	gJfvAssignmentCache.clear();
+	gJfvAssignmentCacheContext.clear();
+	gJfvAssignmentCacheHits = gJfvAssignmentCacheMisses = 0;
+}
+
 void setupDreamAssignmentReader(MemoryStack* tMemoryStack) {
+	clearJfvAssignmentCache();
 	gMugenAssignmentData.mMemoryStack = tMemoryStack;
 }
 
 void shutdownDreamAssignmentReader()
 {
 	gMugenAssignmentData.mMemoryStack = NULL;
+	clearJfvAssignmentCache();
 }
 
 void setDreamAssignmentCommandLookupID(int tID)
@@ -1274,11 +1302,33 @@ uint64_t gJfvAssignmentParseCount = 0;
 
 DreamMugenAssignment*  parseDreamMugenAssignmentFromString(const char* tText) {
 	const uint64_t jfvT0 = getSystemTicks();
+	DreamMugenAssignment* ret = parseDreamMugenAssignmentFromStringCached(tText);
+	gJfvAssignmentParseTicks += getSystemTicks() - jfvT0;
+	gJfvAssignmentParseCount++;
+	return ret;
+}
+
+DreamMugenAssignment* parseDreamMugenAssignmentFromStringCached(const char* tText) {
+	const int isCaching = gMugenAssignmentData.mMemoryStack != NULL;
+	std::string key;
+	if (isCaching) {
+		key.reserve(gJfvAssignmentCacheContext.size() + strlen(tText) + 2);
+		key += gJfvAssignmentCacheContext;
+		key += gMugenAssignmentData.mHasCommandHandlerEntryForLookup ? '\x01' : '\x02';
+		key += tText;
+		auto it = gJfvAssignmentCache.find(key);
+		if (it != gJfvAssignmentCache.end()) {
+			gJfvAssignmentCacheHits++;
+			return it->second;
+		}
+	}
 	char evalText[1024];
 	strcpy(evalText, tText);
 	DreamMugenAssignment* ret = parseDreamMugenAssignmentFromString(evalText);
-	gJfvAssignmentParseTicks += getSystemTicks() - jfvT0;
-	gJfvAssignmentParseCount++;
+	if (isCaching) {
+		gJfvAssignmentCacheMisses++;
+		gJfvAssignmentCache[key] = ret;
+	}
 	return ret;
 }
 
