+	int acquireVitaPaletteForBuffer(const Buffer& tPalette) {
+		std::string key((const char*)tPalette.mData, tPalette.mLength);
+		auto it = gVitaPaletteByKey.find(key);
+		if (it != gVitaPaletteByKey.end()) {
+			gVitaPaletteReferenceCount[it->second]++;
+			return it->second;
 		}
