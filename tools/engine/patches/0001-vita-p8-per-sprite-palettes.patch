+	static int allocateVitaDynamicPaletteID() {
+		if (!gVitaFreePaletteIDs.empty()) {
+			const int id = gVitaFreePaletteIDs.back();
+			gVitaFreePaletteIDs.pop_back();
+			return id;
+		}
+		if (gVitaPalettePageFill == VITA_PALETTES_PER_PAGE) {
+			VitaPalette page;
+			page.mBuffer = vitaGpuAlloc(SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW, VITA_PALETTE_SIZE * VITA_PALETTES_PER_PAGE,
+				SCE_GXM_PALETTE_ALIGNMENT, SCE_GXM_MEMORY_ATTRIB_READ | SCE_GXM_MEMORY_ATTRIB_WRITE, &page.mID);
+			if (!page.mBuffer) {
+				logErrorFormat("[Palette] Unable to allocate palette page %d", (int)gVitaPalettePages.size());
+				abortSystem();
+			}
+			gVitaPalettePages.push_back(page);
+			gVitaPalettePageFill = 0;
+			debugFormat("[Palette] palette page %d allocated", (int)gVitaPalettePages.size());
+		}
+		VitaPalette e;
