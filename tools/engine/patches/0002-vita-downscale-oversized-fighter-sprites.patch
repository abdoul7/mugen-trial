+	// [JFV] Sprites whose width or height is above this cap are stored downscaled by an integer
+	// factor (nearest neighbour) while TextureData keeps the ORIGINAL size. drawing_vita.cpp
+	// computes texture coordinates relative to mTextureSize, so they are still drawn at full size,
+	// just with fewer texels. Set only while fighter sprites load (playerdefinition.cpp); 0 = off.
+	static int gVitaMaximumTextureDimension = 0;
+
+	void setVitaMaximumTextureDimension(int tMaximum) {
+		gVitaMaximumTextureDimension = tMaximum;
+	}
+
+	static int getVitaTextureDownscaleFactor(int tWidth, int tHeight) {
+		const int largest = tWidth > tHeight ? tWidth : tHeight;
+		if (gVitaMaximumTextureDimension <= 0 || largest <= gVitaMaximumTextureDimension) return 1;
+		return (largest + gVitaMaximumTextureDimension - 1) / gVitaMaximumTextureDimension;
+	}
+
+	// copy a tWidth x tHeight image (tBytesPerPixel each) into the texture, keeping every k-th pixel
+	static void copyImageIntoVitaTexture(vita2d_texture* tTexture, const uint8_t* tSource, int tWidth, int tHeight, int tBytesPerPixel, int k) {
+		auto data = (uint8_t*)vita2d_texture_get_datap(tTexture);
+		auto textureStride = vita2d_texture_get_stride(tTexture);
+		const int physicalWidth = (tWidth + k - 1) / k;
+		const int physicalHeight = (tHeight + k - 1) / k;
+		for (int y = 0; y < physicalHeight; y++) {
+			const uint8_t* sourceRow = tSource + size_t(y) * k * tWidth * tBytesPerPixel;
+			uint8_t* targetRow = data + size_t(textureStride) * y;
+			if (k == 1) {
+				memcpy(targetRow, sourceRow, size_t(tWidth) * tBytesPerPixel);
+				continue;
+			}
+			for (int x = 0; x < physicalWidth; x++) {
+				memcpy(targetRow + x * tBytesPerPixel, sourceRow + size_t(x) * k * tBytesPerPixel, tBytesPerPixel);
+			}
+		}
+	}
+
 	TextureData loadTextureFromARGB32Buffer(const Buffer& b, int tWidth, int tHeight) {
 		TextureData returnData;
 		returnData.mTexture = allocTextureMemory(sizeof(VitaTextureData));
