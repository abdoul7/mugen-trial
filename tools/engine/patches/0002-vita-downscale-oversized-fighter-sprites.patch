+		const int k = getVitaTextureDownscaleFactor(tWidth, tHeight);
+		texture->mTexture = createVitaTextureOrAbort((tWidth + k - 1) / k, (tHeight + k - 1) / k, SCE_GXM_TEXTURE_FORMAT_A8R8G8B8);
