+}
+
+// [JFV] patch 0014: with a Legends coach profile, a share (tagBias) of the command picks comes from
+// the fighter's adapter-tagged commands (e.g. approach, poke) instead of a uniform random pick.
+// Only commands the character really defines are used; the rest of the AI is unchanged.
+static const string* pickLegendsTaggedCommand(PlayerAI* e, const LegendsAIProfile& tProfile) {
+	if (tProfile.taggedCommands.empty() || randfrom(0, 1) >= tProfile.tagBias) return nullptr;
+	const string& wanted = tProfile.taggedCommands[randfromInteger(0, int(tProfile.taggedCommands.size()) - 1)];
+	for (const auto& name : e->mCommandNames) if (name == wanted) return &name;
+	return nullptr;
 }
 
 static int setRandomPlayerCommandActiveIfTimePossible(PlayerAI* e) {
 	int i = randfromInteger(0, int(e->mCommandNames.size()) - 1);
-	const string& name = e->mCommandNames[i];
+	const string* picked = &e->mCommandNames[i];
+	LegendsAIProfile profile;
+	const auto hasProfile = getLegendsAIProfile(e->mPlayer->mRootID, &profile);
+	const string* tagged = hasProfile ? pickLegendsTaggedCommand(e, profile) : nullptr;
+	if (tagged) picked = tagged;
+	const string& name = *picked;
 	const auto duration = getDreamCommandMinimumDuration(e->mPlayer->mCommandID, name.data());
 	if (duration < e->mRandomInputNow) {
 		setDreamPlayerCommandActiveForAI(e->mPlayer->mCommandID, name.data(), 2);
+		noteLegendsAICommand(e->mPlayer->mRootID, tagged != nullptr);
 		return 1;
 	}
 	return 0;
