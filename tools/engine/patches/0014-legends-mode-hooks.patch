 static void setRandomPlayerCommandActive(PlayerAI* e) {
 	int i = randfromInteger(0, int(e->mCommandNames.size()) - 1);
 
-	const string& name = e->mCommandNames[i];
+	const string* picked = &e->mCommandNames[i];
+	LegendsAIProfile profile; // [JFV] patch 0014: also on this path (AI.Cheat = 1 in mugen.cfg uses it)
+	const string* tagged = getLegendsAIProfile(e->mPlayer->mRootID, &profile) ? pickLegendsTaggedCommand(e, profile) : nullptr;
